# Web application (local development and Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key

# Local laptop worker only — do not configure these in the browser bundle
RELAY_URL=https://your-relay.example.com
RELAY_WORKER_TOKEN=relay_worker_token_from_the_app
RELAY_WORKER_BACKEND=codex
RELAY_CODEX_PATH=/absolute/path/to/codex
RELAY_CODEX_WORKSPACE=/absolute/path/to/allowed/workspace
# Optional path-delimited list (":" on macOS/Linux, ";" on Windows)
RELAY_CODEX_ADDITIONAL_WRITABLE_DIRS=
RELAY_COMMAND_PATH=/your/normal/shell/command/search/path
RELAY_CODEX_MODEL=
RELAY_CODEX_TIMEOUT_MS=900000
RELAY_POLL_INTERVAL_MS=5000
RELAY_MAX_IDLE_POLL_INTERVAL_MS=60000
# Opt in only after the Vehicles migration and API are deployed.
RELAY_VEHICLE_SEARCH=0
# Optional public seller detail pages checked per vehicle run (0-50).
RELAY_VEHICLE_DETAIL_LIMIT=20
# Optional diagnostic mode: 0 opens a visible Chromium window (requires a display).
RELAY_VEHICLE_BROWSER_HEADLESS=1
# Inject into the Linux worker's protected environment or owner-readable .env.worker.
# Required for vehicle jobs; no OS credential-store fallback.
AUTODEV_API_KEY=

# Only required when RELAY_WORKER_BACKEND=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-sol

# Optional Web Push. Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared bearer secret for the cloud push delivery scheduler
CRON_SECRET=
