# Web application (local development and Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key

# Local laptop worker only — do not configure these in the browser bundle
RELAY_URL=https://your-relay.example.com
RELAY_WORKER_TOKEN=relay_worker_token_from_the_app
RELAY_WORKER_BACKEND=codex
RELAY_CODEX_PATH=codex
RELAY_CODEX_WORKSPACE=/absolute/path/to/allowed/workspace
RELAY_CODEX_MODEL=
RELAY_CODEX_TIMEOUT_MS=900000
RELAY_POLL_INTERVAL_MS=5000
# Optional: overrides the token returned by the locally authenticated `gh` CLI
RELAY_GITHUB_TOKEN=

# Only required when RELAY_WORKER_BACKEND=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-sol
